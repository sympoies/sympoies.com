---
// Faint honeycomb lattice, the line motif of the brand. Decorative; place inside a
// positioned container. The fade at the edges is done in CSS (.lattice).
---

<svg class="lattice" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="lattice-tile" width="52" height="90" patternUnits="userSpaceOnUse">
      <path d="M26 0 L52 15 V45 L26 60 L0 45 V15 Z M26 60 V90" fill="none" stroke="var(--lattice)" stroke-width="1.5"></path>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill="url(#lattice-tile)"></rect>
</svg>
