---
// Illustration for a workflow board: three columns of cards. Decorative; the caller labels it.
const columns = [
  { x: 24, cards: [{ h: 64, accent: false }, { h: 48, accent: false }, { h: 64, accent: true }] },
  { x: 224, cards: [{ h: 48, accent: true }, { h: 64, accent: false }] },
  { x: 424, cards: [{ h: 64, accent: false }, { h: 48, accent: false }, { h: 48, accent: false }] },
];
---

<svg viewBox="0 0 624 390" xmlns="http://www.w3.org/2000/svg" role="img" {...Astro.props}>
  <rect x="0" y="0" width="624" height="390" fill="var(--bg-alt)"></rect>
  <g transform="translate(0 45)">
  {columns.map((col) => {
    let y = 64;
    return (
      <g>
        <rect x={col.x} y="20" width="176" height="260" rx="12" fill="var(--surface)" stroke="var(--border)" stroke-width="2"></rect>
        <rect x={col.x + 16} y="34" width="72" height="10" rx="5" fill="var(--muted)" opacity="0.6"></rect>
        {col.cards.map((c) => {
          const top = y;
          y += c.h + 12;
          return (
            <g>
              <rect x={col.x + 12} y={top} width="152" height={c.h} rx="8" fill="var(--bg-alt)" stroke="var(--border)" stroke-width="2"></rect>
              <rect x={col.x + 24} y={top + 14} width={c.accent ? 56 : 96} height="8" rx="4" fill={c.accent ? 'var(--accent)' : 'var(--border)'}></rect>
              <rect x={col.x + 24} y={top + 32} width="112" height="8" rx="4" fill="var(--border)"></rect>
            </g>
          );
        })}
      </g>
    );
  })}

  </g>
</svg>
