---
import { iconPaths, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
}
const { name, size = 24 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={iconPaths[name]}></path>
</svg>
