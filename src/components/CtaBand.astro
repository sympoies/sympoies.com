---
import { pagePath, type Locale } from '../lib/site';
import { t } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  body: string;
}
const { locale, title, body } = Astro.props;
---

<section class="cta-band">
  <div class="container cta-inner">
    <div>
      <h2>{title}</h2>
      <p>{body}</p>
    </div>
    <a class="button" href={pagePath(locale, 'contact')}>{t(locale).home.ctaPrimary}</a>
  </div>
</section>
