---
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { t } from '../i18n';
import { projects, type ProjectId } from '../lib/projects';
import type { Locale } from '../lib/site';
import agentCollabLight from '../assets/work/agent-collab-light.webp';
import agentCollabDark from '../assets/work/agent-collab-dark.webp';
import salonLight from '../assets/work/salon-light.webp';
import salonDark from '../assets/work/salon-dark.webp';
import symphonyBoardLight from '../assets/work/symphony-board-light.webp';
import symphonyBoardDark from '../assets/work/symphony-board-dark.webp';
import alfredResults from '../assets/work/nils-alfredworkflow-results.svg';
import nilsTerminal from '../assets/work/nils-cli-terminal.svg';
import runtimeTerminal from '../assets/work/agent-runtime-kit-terminal.svg';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = t(locale).work;
const screenshots: Partial<Record<ProjectId, { light: ImageMetadata; dark: ImageMetadata }>> = {
  agentCollab: { light: agentCollabLight, dark: agentCollabDark },
  salon: { light: salonLight, dark: salonDark },
  symphonyBoard: { light: symphonyBoardLight, dark: symphonyBoardDark },
};
const illustrations: Partial<Record<ProjectId, ImageMetadata>> = {
  nilsCli: nilsTerminal,
  agentRuntimeKit: runtimeTerminal,
  nilsAlfredWorkflow: alfredResults,
};
// Match the card grid's maximum width, two-column threshold and card borders.
const sizes = '(min-width: 70rem) 33.25rem, (min-width: 47.25rem) calc((100vw - 3.5rem) / 2), calc(100vw - 2.125rem)';
const imageOptions = { widths: [420, 720, 1080, 1440], sizes, format: 'webp' as const };
---

<Base locale={locale} page="work" title={c.title} description={c.description}>
  <section class="page-head">
    <div class="container">
      <h1>{c.heading}</h1>
      <p class="lead">{c.lead}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ul class="grid grid-2 cards">
        {projects.map(async (p) => {
          const alt = c.projects[p.id].alt;
          const screenshot = screenshots[p.id];
          const illustration = illustrations[p.id];
          // Keep the denser Activity capture within the Work page image budget.
          const options = p.id === 'symphonyBoard' ? { ...imageOptions, quality: 38 } : imageOptions;
          const dark = screenshot && await getImage({ src: screenshot.dark, ...options });
          return (
            <li class="card project">
              <div class="visual">
                {screenshot && dark && (
                  <picture>
                    <source media="(prefers-color-scheme: dark)" type="image/webp" srcset={dark.srcSet.attribute} sizes={sizes} />
                    <Image src={screenshot.light} alt={alt} {...options} loading={p.id === 'symphonyBoard' ? 'eager' : 'lazy'} />
                  </picture>
                )}
                {illustration && (
                  <img src={illustration.src} alt={alt} width={illustration.width} height={illustration.height} loading="lazy" decoding="async" />
                )}
              </div>
              <h2 class="project-name">
                <span class="mono">{p.name}</span>
                {p.early && <span class="badge">{c.earlyLabel}</span>}
              </h2>
              <p>{c.projects[p.id].description}</p>
              <p class="project-links">
                <a href={p.repo} rel="noopener">{c.repoLink}<span class="sr-only"> — {p.name}</span> ↗</a>
                {p.demo && <a href={p.demo} rel="noopener">{c.demoLink}<span class="sr-only"> — {p.name}</span> ↗</a>}
                {p.releases && <a href={p.releases} rel="noopener">{c.releasesLink}<span class="sr-only"> — {p.name}</span> ↗</a>}
              </p>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</Base>
