---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { t } from '../i18n';
import { pagePath, type Locale } from '../lib/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = t(locale).home;
---

<Base locale={locale} page="home" title={c.title} description={c.description}>
  <section class="hero">
    <div class="container">
      <h1>{c.heroTitle}</h1>
      <p class="lead">{c.heroLead}</p>
      <p class="actions">
        <a class="button" href={pagePath(locale, 'contact')}>{c.ctaPrimary}</a>
        <a class="button secondary" href={pagePath(locale, 'work')}>{c.ctaSecondary}</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>{c.pillarsTitle}</h2>
      <ul class="grid grid-3 cards">
        {c.pillars.map((p) => (
          <li class="card">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))}
      </ul>
      <p><a class="more" href={pagePath(locale, 'services')}>{c.learnMore} →</a></p>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <h2>{c.processTitle}</h2>
      <p class="lead small-lead">{c.processLead}</p>
      <ol class="steps">
        {c.steps.map((s) => (
          <li>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand locale={locale} title={c.ctaTitle} body={c.ctaBody} />
</Base>
