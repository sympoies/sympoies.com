---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { t } from '../i18n';
import type { Locale } from '../lib/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = t(locale).services;
---

<Base locale={locale} page="services" title={c.title} description={c.description}>
  <section class="page-head">
    <div class="container">
      <h1>{c.heading}</h1>
      <p class="lead">{c.lead}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>{c.areasTitle}</h2>
      <ul class="grid grid-3 cards">
        {c.areas.map((a) => (
          <li class="card">
            <h3>{a.title}</h3>
            <p>{a.body}</p>
            <ul class="bullets">
              {a.items.map((i) => <li>{i}</li>)}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <h2>{c.engagementTitle}</h2>
      <p class="lead small-lead">{c.engagementLead}</p>
      <ol class="steps steps-4">
        {c.stages.map((s) => (
          <li>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand locale={locale} title={c.ctaTitle} body={c.ctaBody} />
</Base>
