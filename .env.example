# Public URL the site is served from, including any sub-path. Default: http://localhost:4321/
# SITE_URL=https://sympoies.com/

# Optional form-forwarding endpoint for the contact page (a public URL, not a secret).
# When unset, the form opens the visitor's mail client with the message prefilled.
# PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/your-form-id
